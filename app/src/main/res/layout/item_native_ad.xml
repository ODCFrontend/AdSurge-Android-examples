<?xml version="1.0" encoding="utf-8"?>
<com.adsurge.adn.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/native_ad_view">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Ad Icon and Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Ad Icon -->
            <ImageView
                android:id="@+id/iv_ad_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="16dp"
                android:scaleType="centerCrop"
                android:background="@color/md_theme_light_surface" />

            <!-- Ad Title and Description -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_ad_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ad Headline"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_light_onSurface"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_ad_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ad body description goes here..."
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_light_onSurface"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

        </LinearLayout>

        <!-- Ad Media Content -->
        <com.adsurge.adn.ads.nativead.MediaView
            android:id="@+id/ad_media_view"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/md_theme_light_surface" />

        <!-- Ad Action Button -->
        <Button
            android:id="@+id/btn_ad_action"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Install"
            android:textColor="@color/md_theme_light_onPrimary"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Bottom-left FrameLayout for AdChoices -->
    <FrameLayout
        android:id="@+id/fl_ad_choices"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_margin="12dp"
        android:layout_gravity="top|end" />

</com.adsurge.adn.ads.nativead.NativeAdView>
