<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:gravity="center"
        android:text="AdSurge Demo"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/md_theme_light_onPrimary"
        android:background="@color/md_theme_light_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- SDK Status Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_marginBottom="24dp"
                android:background="@color/card_background">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SDK Status"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_light_onSurface"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_sdk_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Initializing..."
                    android:textSize="16sp"
                    android:textColor="@color/md_theme_light_onSurface" />
            </LinearLayout>

            <!-- Interstitial Ad Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_marginBottom="24dp"
                android:background="@color/card_background">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Interstitial Ad"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_light_onSurface"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_interstitial_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_light_onSurface"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btn_show_interstitial"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Show Interstitial"
                    android:enabled="false" />
            </LinearLayout>

            <!-- Rewarded Ad Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_marginBottom="24dp"
                android:background="@color/card_background">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rewarded Ad"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_light_onSurface"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_rewarded_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_light_onSurface"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btn_show_rewarded"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Show Rewarded"
                    android:enabled="false" />
            </LinearLayout>

            <!-- Banner Ad Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_marginBottom="24dp"
                android:background="@color/card_background">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Banner Ad"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_light_onSurface"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_banner_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_light_onSurface"
                    android:layout_marginBottom="16dp" />

                <FrameLayout
                    android:id="@+id/fl_banner_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal" />

            </LinearLayout>

            <!-- Native Ad Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_marginBottom="24dp"
                android:background="@color/card_background">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Native Ad"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_light_onSurface"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_native_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_light_onSurface"
                    android:layout_marginBottom="16dp" />

                <FrameLayout
                    android:id="@+id/fl_native_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <!-- App Open Ad Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_marginBottom="24dp"
                android:background="@color/card_background">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="App Open Ad"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_light_onSurface"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_app_open_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_light_onSurface"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btn_show_app_open"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Show App Open Ad"
                    android:enabled="false" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
